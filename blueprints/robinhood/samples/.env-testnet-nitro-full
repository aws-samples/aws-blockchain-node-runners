##############################################################
# Robinhood Chain Testnet - Arbitrum Nitro (Full Node)
# Chain ID 46630 - settles to Ethereum Sepolia
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="robinhood"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="testnet"
CLIENT_CONFIG="nitro-v3.11.5-full.yml"

# Instance Configuration
# m6i.2xlarge: 8 vCPU, 32 GB RAM - sufficient for the testnet.
INSTANCE_TYPE="m6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="1000"
DATA_VOL_1_IOPS="5000"
DATA_VOL_1_THROUGHPUT="500"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# See the mainnet sample / README for notes on Arbitrum Nitro snapshots.
SNAPSHOT_ENABLED="false"
# RECOMMENDED: restore from a published pruned-full-node snapshot so the node
# does NOT sync from genesis. A from-genesis sync needs an archive-grade L1
# endpoint (public/free Sepolia prunes the historical logs the rollup genesis
# assertion needs). Pick a snapshot URL from:
#   https://snapshot-explorer.arbitrum.io/?chain=Robinhood+Chain+Sepolia
# Use the snapshot DIRECTORY URL with a trailing slash, not a .tar.partNNNN
# file. The restore needs ~2x the snapshot size free (testnet: ~250 GiB).
# ROBINHOOD_SNAPSHOT_URL="https://robinhood-snapshots.offchainlabs.com/robinhood%20chain%20sepolia/<YYYY-MM-DD-id>/"

# Robinhood Custom Configuration
# REQUIRED: your own Ethereum SEPOLIA L1 endpoints (execution RPC + beacon).
# NOTE: the node starts a local blob proxy in front of this beacon (see
# user-data/common/blob-proxy.py). The beacon must serve blobs back to the
# snapshot's date; beacons keep them ~18 days, so use a recent snapshot.
#
# Execution RPC: it must serve eth_getLogs for L1 blocks back to the snapshot's
# date, because Nitro replays the inbox from there after a restore. Tested from
# EC2: publicnode's Sepolia RPC returns "pruned history unavailable" for older
# ranges and onFinality's free endpoint returned 429 on every request.
# Tenderly's keyless public gateway served the full catch-up.
ROBINHOOD_L1_RPC_URL="https://sepolia.gateway.tenderly.co"
ROBINHOOD_L1_BEACON_URL="https://ethereum-sepolia-beacon-api.publicnode.com"

# Node ports (optional - defaults shown)
# ROBINHOOD_RPC_PORT="8547"
# ROBINHOOD_WS_PORT="8548"
# ROBINHOOD_METRICS_PORT="6070"
