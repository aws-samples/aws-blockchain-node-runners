##############################################################
# Robinhood Chain Mainnet - Arbitrum Nitro (Full Node, HA)
# Chain ID 4663 - settles to Ethereum mainnet
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="robinhood"
DEPLOYMENT_MODE="ha-nodes"
BC_NETWORK="mainnet"
CLIENT_CONFIG="nitro-v3.11.5-full.yml"

# Instance Configuration
INSTANCE_TYPE="m6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="2200"
DATA_VOL_1_IOPS="5000"
DATA_VOL_1_THROUGHPUT="500"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
SNAPSHOT_ENABLED="false"
# Restore each node from the latest Robinhood snapshot DIRECTORY URL (trailing
# slash; mainnet snapshots are multi-part). Needs ~2x the snapshot size free,
# hence DATA_VOL_1_SIZE="2200". See .env-mainnet-nitro-full and the README.
# ROBINHOOD_SNAPSHOT_URL="https://robinhood-snapshots.offchainlabs.com/robinhood%20chain/<YYYY-MM-DD-id>/"

# HA Configuration
HA_NUMBER_OF_NODES="2"
HA_ALB_HEALTHCHECK_PORT="8547"
HA_ALB_HEALTHCHECK_PATH="/"
# A Nitro node answers a plain GET / on the RPC port with HTTP 400 (it expects
# a JSON-RPC POST). A 400 therefore means the node is up and serving, so accept
# it alongside 200 — otherwise the ALB marks every node unhealthy (default is
# "200") and the ASG replaces them in a loop. (Same class of fix as Base's 405.)
HA_ALB_HEALTHCHECK_HTTP_CODES="200,400"
HA_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="60"
HA_ALB_HEALTHCHECK_INTERVAL_SEC="30"
HA_ALB_HEALTHCHECK_TIMEOUT_SEC="10"
HA_ALB_HEALTHCHECK_HEALTHY_THRESHOLD="2"
HA_ALB_HEALTHCHECK_UNHEALTHY_THRESHOLD="3"
HA_NODES_HEARTBEAT_DELAY_MIN="60"
HA_ALB_DEREGISTRATION_DELAY_SEC="60"

# Robinhood Custom Configuration
# Ethereum MAINNET L1 endpoints (execution RPC + beacon). Free, no-key defaults;
# the node tolerates free-endpoint rate limits during catch-up (see node.sh),
# so no paid provider is required. The RPC must serve eth_getLogs for L1
# blocks back to the snapshot's date; publicnode's free RPC refuses logs older
# than about a day ("Archive requests require a personal token"), so it is NOT
# usable here. Free, keyless alternative: https://rpc.mevblocker.io
ROBINHOOD_L1_RPC_URL="https://mainnet.gateway.tenderly.co"
ROBINHOOD_L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"

# ALB Exposure (security)
# By default the load balancer is INTERNAL (reachable only inside the VPC) and
# ingress is restricted to the VPC CIDR. To expose the RPC endpoint beyond the
# VPC, uncomment and set the following:
# HA_ALB_INTERNET_FACING="true"          # expose the ALB to the internet (use with caution)
# HA_ALB_ALLOWED_CIDR="203.0.113.0/24"   # REQUIRED when internet-facing: restrict to trusted source IPs
# HA_ALB_CERTIFICATE_ARN="arn:aws:acm:REGION:ACCOUNT:certificate/ID"  # enable HTTPS (TLS terminated at the ALB)
