##############################################################
# Robinhood Chain Mainnet - Arbitrum Nitro (Full Node)
# Chain ID 4663 - settles to Ethereum mainnet
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="robinhood"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="mainnet"
CLIENT_CONFIG="nitro-v3.11.5-full.yml"

# Instance Configuration
# m6i.2xlarge: 8 vCPU, 32 GB RAM. Robinhood docs recommend 64 GB+ for mainnet;
# step up to m6i.4xlarge / m7g.4xlarge for a heavier mainnet workload.
INSTANCE_TYPE="m6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="2200"
DATA_VOL_1_IOPS="5000"
DATA_VOL_1_THROUGHPUT="500"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# SNAPSHOT_ENABLED is the framework's own S3 snapshot restore; Robinhood Chain
# snapshots are published by Offchain Labs instead and restored by Nitro itself
# via ROBINHOOD_SNAPSHOT_URL below. See the README "Database Snapshots" section.
SNAPSHOT_ENABLED="false"
# RECOMMENDED: restore from the latest published pruned snapshot. Use the
# snapshot DIRECTORY URL (trailing slash), not a .tar.partNNNN file: mainnet
# snapshots are multi-part and Nitro only fetches all parts from the directory.
# Latest snapshots: https://snapshot-explorer.arbitrum.io/?chain=Robinhood+Chain
# The restore needs ~2x the snapshot size free on the data volume (the
# 2026-10-09 snapshot is 925 GiB), hence DATA_VOL_1_SIZE="2200" above.
# ROBINHOOD_SNAPSHOT_URL="https://robinhood-snapshots.offchainlabs.com/robinhood%20chain/<YYYY-MM-DD-id>/"

# Robinhood Custom Configuration
# Ethereum MAINNET L1 endpoints (execution RPC + beacon).
# Free, no-key defaults below work; the node is configured to TOLERATE free
# public-endpoint rate limits during snapshot catch-up (Nitro retries 429s with
# backoff and throttles its L1 inbox read rate — see node.sh), so no paid
# provider is required. The RPC must serve eth_getLogs for L1 blocks back to
# the snapshot's date: after a restore, Nitro replays the inbox from there.
# publicnode's free RPC refuses logs older than about a day ("Archive requests
# require a personal token"), so it is NOT usable here. Free, keyless
# alternative that serves old logs: https://rpc.mevblocker.io
ROBINHOOD_L1_RPC_URL="https://mainnet.gateway.tenderly.co"
ROBINHOOD_L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"

# Node ports (optional - defaults shown)
# ROBINHOOD_RPC_PORT="8547"
# ROBINHOOD_WS_PORT="8548"
# ROBINHOOD_METRICS_PORT="6070"
