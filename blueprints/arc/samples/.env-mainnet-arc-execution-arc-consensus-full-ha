##############################################################
# Arc Mainnet - arc-execution + arc-consensus (Full Node, HA)
# Chain ID 5042 - Circle's stablecoin-native EVM L1 (USDC gas)
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="arc"
DEPLOYMENT_MODE="ha-nodes"
BC_NETWORK="mainnet"
CLIENT_CONFIG="arc-execution-0.8.1-arc-consensus-0.8.1-full.yml"

# Instance Configuration
# Arc requires 64 GB+ RAM and favours clock speed over core count.
# r7i.2xlarge: 8 vCPU, 64 GB RAM. ARM alternative: r7g.2xlarge with CPU_TYPE="ARM_64".
INSTANCE_TYPE="r7i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
# Arc's minimum is a 1 TB SSD. The mainnet full-profile snapshot is ~35 GB today and grows with the chain.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="1000"
DATA_VOL_1_IOPS="6000"
DATA_VOL_1_THROUGHPUT="500"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# Arc cannot sync from genesis. On first start the node restores the newest
# Circle-published snapshot pair from https://snapshots.arc.network
# automatically (no URL to configure). The framework's own snapshot feature
# stays off.
SNAPSHOT_ENABLED="false"

# HA Configuration
HA_NUMBER_OF_NODES="2"
HA_ALB_HEALTHCHECK_PORT="8545"
HA_ALB_HEALTHCHECK_PATH="/"
# The execution layer expects JSON-RPC POSTs; a plain GET / gets a non-200
# status while the node is serving. Accept those codes, or the ALB marks every
# node unhealthy and the ASG replaces them in a loop.
HA_ALB_HEALTHCHECK_HTTP_CODES="200,400,405"
# First start restores the snapshot before the RPC port opens.
HA_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="60"
HA_ALB_HEALTHCHECK_INTERVAL_SEC="30"
HA_ALB_HEALTHCHECK_TIMEOUT_SEC="10"
HA_ALB_HEALTHCHECK_HEALTHY_THRESHOLD="2"
HA_ALB_HEALTHCHECK_UNHEALTHY_THRESHOLD="3"
HA_NODES_HEARTBEAT_DELAY_MIN="60"
HA_ALB_DEREGISTRATION_DELAY_SEC="60"

# Arc Custom Configuration (all optional)
# Relay endpoints the consensus layer follows, space-separated
# "https://host,wss=host" entries. Defaults to Circle's public, keyless relays
# for the selected network (see https://docs.arc.io/arc/references/node-requirements).
# ARC_FOLLOW_ENDPOINTS="https://rpc.example.arc.io,wss=rpc.example.arc.io"
# Where submitted transactions are forwarded for broadcast (default: Circle's primary RPC).
# ARC_RPC_FORWARDER="https://rpc.mainnet.arc.io/"
# Node ports (defaults shown)
# ARC_RPC_PORT="8545"
# ARC_WS_PORT="8546"

# ALB Exposure (security)
# By default the load balancer is INTERNAL (reachable only inside the VPC) and
# ingress is restricted to the VPC CIDR. To expose the RPC endpoint beyond the
# VPC, uncomment and set the following:
# HA_ALB_INTERNET_FACING="true"          # expose the ALB to the internet (use with caution)
# HA_ALB_ALLOWED_CIDR="203.0.113.0/24"   # REQUIRED when internet-facing: restrict to trusted source IPs
# HA_ALB_CERTIFICATE_ARN="arn:aws:acm:REGION:ACCOUNT:certificate/ID"  # enable HTTPS (TLS terminated at the ALB)
