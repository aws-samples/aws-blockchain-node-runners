##############################################################
# Arc Testnet - arc-execution + arc-consensus (Full Node)
# Chain ID 5042002 - Circle's stablecoin-native EVM L1 (USDC gas)
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="arc"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="testnet"
CLIENT_CONFIG="arc-execution-0.8.1-arc-consensus-0.8.1-full.yml"

# Instance Configuration
# Arc requires 64 GB+ RAM and favours clock speed over core count.
# r7i.2xlarge: 8 vCPU, 64 GB RAM. ARM alternative: r7g.2xlarge with CPU_TYPE="ARM_64".
INSTANCE_TYPE="r7i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
# Arc's minimum is a 1 TB SSD. The testnet snapshot is ~320 GB; leave headroom for growth.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="1000"
DATA_VOL_1_IOPS="6000"
DATA_VOL_1_THROUGHPUT="500"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# Arc cannot sync from genesis. On first start the node restores the newest
# Circle-published snapshot pair from https://snapshots.arc.network
# automatically (no URL to configure). The framework's own snapshot feature
# stays off.
SNAPSHOT_ENABLED="false"

# Arc Custom Configuration (all optional)
# Relay endpoints the consensus layer follows, space-separated
# "https://host,wss=host" entries. Defaults to Circle's public, keyless relays
# for the selected network (see https://docs.arc.io/arc/references/node-requirements).
# ARC_FOLLOW_ENDPOINTS="https://rpc.example.arc.io,wss=rpc.example.arc.io"
# Where submitted transactions are forwarded for broadcast (default: Circle's primary RPC).
# ARC_RPC_FORWARDER="https://rpc.mainnet.arc.io/"
# Node ports (defaults shown)
# ARC_RPC_PORT="8545"
# ARC_WS_PORT="8546"
