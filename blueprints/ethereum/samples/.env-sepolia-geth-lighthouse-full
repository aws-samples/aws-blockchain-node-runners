##############################################################
# Ethereum Sepolia Testnet - Geth + Lighthouse (Full Node)
#
# Uses the Glamsterdam/Gloas-ready client set for the Sepolia fork
# (6 Oct 2026, 13:53:36 UTC): Geth 1.17.7 + Lighthouse 8.3.0-rc.0.
# Lighthouse 8.3.0-rc.0 is a release candidate — it is the only build with
# Sepolia Gloas support; mainnet configs intentionally stay on stable.
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Stack Name Prefix (optional - deploy multiple stacks with same config on one account)
# STACK_NAME_PREFIX="DEV"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="ethereum"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="sepolia"
CLIENT_CONFIG="geth-1.17.7-lighthouse-8.3.0-rc.0-full.yml"

# Instance Configuration
# Smaller instance for testnet
INSTANCE_TYPE="r7g.xlarge"
CPU_TYPE="ARM_64"

# Storage Configuration
# Measured 2026-10-02 (geth 1.17.5 + Lighthouse 8.2.2 supernode, default flags):
# ~980 GB on disk at sync (geth ~906 GB, of which ~670 GB is block history;
# Lighthouse ~74 GB). 1500 GB leaves room for growth, which speeds up after
# Glamsterdam's 200M gas limit, and geth's 5 GB low-disk shutdown. geth stops
# (and must re-sync) if the volume fills during the initial sync. To keep only
# post-Prague history (~570 GB), see "Sepolia storage and history pruning" in
# the README.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="1500"
DATA_VOL_1_IOPS="3000"
DATA_VOL_1_THROUGHPUT="250"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_DEVICE_NAME="/dev/xvdg"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration (optional)
SNAPSHOT_ENABLED="false"

# Ethereum Custom Configuration
ETH_CONSENSUS_CHECKPOINT_SYNC_URL="https://checkpoint-sync.sepolia.ethpandaops.io"

# Supernode mode (Lighthouse only) - stores all 128 data columns for full blob serving.
# Required post-Pectra (May 2025) for blob_sidecars API and L2 rollup derivation.
# Options: "true" (supernode, 128 columns), "semi" (semi-supernode, 64 columns), "false" (regular, 4 columns)
ETH_CONSENSUS_SUPERNODE="true"
