##############################################################
# Ethereum Sepolia Testnet - Geth + Lighthouse (Full Node)
#
# Uses the Glamsterdam/Gloas-ready client set for the Sepolia fork
# (6 Oct 2026, 13:53:36 UTC): Geth 1.17.7 + Lighthouse 8.3.0-rc.0.
# Lighthouse 8.3.0-rc.0 is a release candidate — it is the only build with
# Sepolia Gloas support; mainnet configs intentionally stay on stable.
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Stack Name Prefix (optional - deploy multiple stacks with same config on one account)
# STACK_NAME_PREFIX="DEV"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="ethereum"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="sepolia"
CLIENT_CONFIG="geth-1.17.7-lighthouse-8.3.0-rc.0-full.yml"

# Instance Configuration
# Smaller instance for testnet
INSTANCE_TYPE="r7g.xlarge"
CPU_TYPE="ARM_64"

# Storage Configuration
# Measured 2026-10-02 (geth 1.17.5, default flags): geth ~906 GB at sync, of
# which ~670 GB is block history. Lighthouse blob data adds ~15 GB with
# ETH_CONSENSUS_SUPERNODE "false" (below), so ~920 GB in total; 1500 GB leaves
# room for growth, which speeds up after Glamsterdam's 200M gas limit. With
# "true" (supernode), Lighthouse keeps all 128 blob columns (~470-720 GB,
# estimated from Hoodi): use 2000 GB. geth stops (and must re-sync) if the
# volume fills during the initial sync. To keep only post-Prague history
# (~510 GB with "false"), see "Sepolia storage and history pruning" in the
# README.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="1500"
DATA_VOL_1_IOPS="3000"
DATA_VOL_1_THROUGHPUT="250"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_DEVICE_NAME="/dev/xvdg"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration (optional)
SNAPSHOT_ENABLED="false"

# Ethereum Custom Configuration
ETH_CONSENSUS_CHECKPOINT_SYNC_URL="https://checkpoint-sync.sepolia.ethpandaops.io"

# Supernode mode (Lighthouse only). "false" keeps 4 of 128 blob data columns:
# enough for an RPC node, but the blob_sidecars API won't work. Use "true"
# (128 columns) or "semi" (64) to serve blobs, e.g. for L2 rollup nodes; both
# need much more disk (see Storage Configuration above). Changing this on an
# existing node, in either direction, needs a beacon re-sync: see "Supernode
# Mode" in the README.
ETH_CONSENSUS_SUPERNODE="false"
