##############################################################
# Ethereum Hoodi Testnet - Geth + Lighthouse (Full Node)
#
# Uses stable clients (Geth 1.17.10 + Lighthouse 8.3.3). Upstream postponed
# Glamsterdam on Hoodi: these releases cancel the 26 Oct 2026 activation, and a
# new date will come in a future release. Do not run Geth 1.17.9 or Lighthouse
# 8.3.0/8.3.1 on Hoodi; they still schedule the cancelled fork.
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Stack Name Prefix (optional - deploy multiple stacks with same config on one account)
# STACK_NAME_PREFIX="DEV"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="ethereum"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="hoodi"
CLIENT_CONFIG="geth-1.17.10-lighthouse-8.3.3-full.yml"

# Instance Configuration
# Smaller instance for testnet
INSTANCE_TYPE="r7g.xlarge"
CPU_TYPE="ARM_64"

# Storage Configuration
# Measured 2026-10 (geth 1.17.7 + Lighthouse 8.2.2): geth ~110 GB; Lighthouse
# blob data ~15 GB for the ~18-day retention window with ETH_CONSENSUS_SUPERNODE
# "false" (below). 200 GB is about 50% headroom. With "true" (supernode),
# Lighthouse keeps all 128 blob columns, ~470 GB at today's blob rate and up to
# ~720 GB if blocks stay full: use 1000 GB.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="200"
DATA_VOL_1_IOPS="3000"
DATA_VOL_1_THROUGHPUT="250"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_DEVICE_NAME="/dev/xvdg"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration (optional)
SNAPSHOT_ENABLED="false"

# Ethereum Custom Configuration
ETH_CONSENSUS_CHECKPOINT_SYNC_URL="https://checkpoint-sync.hoodi.ethpandaops.io"

# Supernode mode (Lighthouse only). "false" keeps 4 of 128 blob data columns:
# enough for an RPC node, but the blob_sidecars API won't work. Use "true"
# (128 columns) or "semi" (64) to serve blobs, e.g. for L2 rollup nodes; both
# need much more disk (see Storage Configuration above). Changing this on an
# existing node, in either direction, needs a beacon re-sync: see "Supernode
# Mode" in the README.
ETH_CONSENSUS_SUPERNODE="false"
