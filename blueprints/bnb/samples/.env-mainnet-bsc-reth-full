##############################################################
# BNB Smart Chain Mainnet - BSC Reth (Full Node)
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="bnb"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="mainnet"
CLIENT_CONFIG="bsc-reth-v0.1.2-full.sh"

# Instance Configuration
INSTANCE_TYPE="i8g.8xlarge"
CPU_TYPE="ARM_64"

# Storage Configuration - instance store (single NVMe, no RAID)
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="instance-store"
DATA_VOL_1_SIZE="3750"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# BNB Custom Configuration
BNB_DOWNLOAD_SNAPSHOT="true"
# Snapshot type for reth: 48Club publishes "fast" for the reth client
# (the "local"/"none" types apply to the geth client, not reth).
BNB_SNAPSHOT_TYPE="fast"

# Snapshot Staging Volume (GiB). The compressed reth.fast archive is ~458 GiB;
# a 600 GiB staging volume holds it during download so the extracted data has
# the full instance-store for itself. Deleted automatically after extraction.
# Set to 0 or omit to download directly to /data.
SNAPSHOT_STAGING_VOL_SIZE="600"
